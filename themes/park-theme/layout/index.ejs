---
layout: layout
---

<!-- ===== HERO 幻灯片区域 ===== -->
<section class="hero" id="hero">
  <% if (theme.hero && theme.hero.slides) { %>
    <% theme.hero.slides.forEach(function(slide, index) { %>
      <div class="hero-slide <%= index === 0 ? 'active' : '' %>" style="background-image: url('/images/slide-<%= ['parking','security','service'][index] %>.jpg');">
        <div class="slide-overlay"></div>
      </div>
    <% }); %>

    <div class="hero-dots">
      <% theme.hero.slides.forEach(function(slide, index) { %>
        <button class="hero-dot <%= index === 0 ? 'active' : '' %>" data-slide="<%= index %>"></button>
      <% }); %>
    </div>
  <% } %>

  <div class="hero-content">
    <div class="hero-text-wrapper">
      <h1>
        <span class="gradient-text"><%= theme.hero.slides[0].title %></span>
      </h1>
      <p class="hero-sub"><%= theme.hero.slides[0].description %></p>
      <div class="hero-buttons">
        <a href="<%= theme.hero.slides[0].button_link %>" class="btn btn-primary"><%= theme.hero.slides[0].button_text %></a>
        <a href="/contact/" class="btn btn-secondary">联系我们 →</a>
      </div>
    </div>
  </div>

  <div class="scroll-indicator">
    <span>SCROLL</span>
    <div class="arrow"></div>
  </div>
</section>

<!-- ===== 核心服务 ===== -->
<section id="services" class="section">
  <div class="container">
    <h2 class="section-title reveal">四大 <span class="highlight">核心服务</span></h2>
    <p class="section-desc reveal">专注智慧停车与安防监控两大领域，提供一站式智能化解决方案</p>
    <div class="services-grid">
      <div class="service-card reveal">
        <div class="service-icon">🅿️</div>
        <h3>智慧停车场建设</h3>
        <p>车牌识别、车位引导、无感支付、云端管理平台，全流程智能化停车体验。覆盖住宅小区、商业综合体、医院、写字楼等各类场景。</p>
      </div>
      <div class="service-card reveal">
        <div class="service-icon">📹</div>
        <h3>安防监控系统</h3>
        <p>高清数字监控、AI智能分析、夜视全彩、远程实时查看。提供监控系统设计、安装、调试、维护一站式服务，全方位守护安全。</p>
      </div>
      <div class="service-card reveal">
        <div class="service-icon">🔌</div>
        <h3>信息系统集成</h3>
        <p>智能控制系统集成、多系统协同、统一平台管理。计算机软硬件销售、网络设备部署、信息系统运行维护，专业7×24技术保障。</p>
      </div>
      <div class="service-card reveal">
        <div class="service-icon">📡</div>
        <h3>弱电与通讯工程</h3>
        <p>通讯设备销售安装、综合布线、弱电智能化工程、安防设备销售。门禁系统、楼宇对讲、公共广播等弱电工程设计与施工。</p>
      </div>
    </div>
  </div>
</section>

